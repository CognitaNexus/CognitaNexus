<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.cognitanexus</groupId>
    <artifactId>cognitanexus-parent</artifactId>
    <version>0.2.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>shared-kernel</artifactId>
  <name>CognitaNexus Shared Kernel</name>
  <description>纯 Java 基础值类型与错误标识，不含框架依赖</description>

  <dependencies>
    <!-- 只允许纯 Java 测试基线：JUnit 与 AssertJ，不引入 Spring 测试栈 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 共享内核必须保持零框架依赖，禁止 Spring/MyBatis 出现在 classpath -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>ban-frameworks-in-shared-kernel</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework*</exclude>
                    <exclude>org.mybatis*</exclude>
                    <exclude>jakarta.servlet*</exclude>
                    <exclude>com.fasterxml.jackson*</exclude>
                  </excludes>
                  <message>Banned dependency: shared-kernel must stay framework-free (pure Java only)</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
