<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.cognitanexus</groupId>
    <artifactId>cognitanexus-parent</artifactId>
    <version>0.2.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>query-service</artifactId>
  <name>CognitaNexus Query Service</name>
  <description>查询与分析：读投影、发布水位、检索、统计、论文合作图与最短路径</description>

  <dependencies>
    <dependency>
      <groupId>com.cognitanexus</groupId>
      <artifactId>shared-kernel</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- OpenAPI 文档：/v3/api-docs 与 /swagger-ui/index.html。核心服务的文档需要登录后访问。 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- 三个核心模块之一：query/analytics（统计口径与合作网络路径）单独出覆盖率报告 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check-analytics</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <skip>${jacoco.check.skip}</skip>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
              <rules>
                <rule>
                  <!--
                    规则挂在 PACKAGE 而非 BUNDLE：JaCoCo 的 includes 相对 element 匹配，
                    element=BUNDLE 时它比的是 bundle 名（query-service），写包名会匹配空集合，
                    空集合一律判通过 —— 门禁就成了摆设。挂 PACKAGE 后 analytics 的各子包逐个受检。

                    模式用 包名* 而不是 包名.* ：JaCoCo 译通配符时 * → .*，模式里的「.」是正则的
                    「任意字符」，所以 `analytics.*` 要求「analytics」后面还有字符，匹配到的只有子包；
                    对没有子包的包会变成空集合、静默判通过。包名* 同时覆盖包本身与子包。
                  -->
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.cognitanexus.query.analytics*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <!--
            第三个核心模块：query/discovery（检索、学者检索、分面、导出）。

            这条门禁此前缺失，实测 discovery.api 行覆盖为 0%、application 为 38.36%，
            而「三个核心模块行覆盖率 ≥80%」是本项目自己写在编码规范里的要求——一条不存在的
            门禁不会报失败，只会让「已达标」变成一句没有依据的话。

            与 analytics 那条保持同一写法（PACKAGE + 包名*），原因见上面的注释。
          -->
          <execution>
            <id>jacoco-check-discovery</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <skip>${jacoco.check.skip}</skip>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
              <rules>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.cognitanexus.query.discovery*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
