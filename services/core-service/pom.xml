<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.cognitanexus</groupId>
    <artifactId>cognitanexus-parent</artifactId>
    <version>0.2.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>core-service</artifactId>
  <name>CognitaNexus Core Service</name>
  <description>核心业务：账号授权、学者与成果、门户认领、治理、审计、Outbox</description>

  <dependencies>
    <dependency>
      <groupId>com.cognitanexus</groupId>
      <artifactId>shared-kernel</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- OpenAPI 文档：/v3/api-docs 与 /swagger-ui/index.html。核心服务的文档需要登录后访问。 -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.session</groupId>
      <artifactId>spring-session-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- 三个核心模块之一：governance（去重与消歧规则）单独出覆盖率报告 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check-governance</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <skip>${jacoco.check.skip}</skip>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
              <rules>
                <rule>
                  <!--
                    规则必须挂在 PACKAGE 上，不能挂在 BUNDLE 上。JaCoCo 的 includes 是相对
                    element 匹配的：element=BUNDLE 时它匹配的是 bundle 名（这里是 core-service），
                    写包名会匹配到空集合，而空集合一律判为「通过」——门禁看着在，其实一道没拦。
                    挂在 PACKAGE 上，includes 才是包名。

                    模式写成 包名* 而不是 包名.* ：JaCoCo 把通配符译成正则时 * → .* ，而模式里的
                    「.」是正则的「任意字符」而不是字面点号，于是 `governance.*` 实际上要求
                    「governance」后面还有字符——包元素自身的名字正好是 `...governance`，匹配不上，
                    匹配到的只有它的子包。对一个**没有子包**的包（如 catalog.domain）这句话就是
                    「匹配空集合」，门禁会静默判通过。用 包名* 才同时覆盖包本身与它的子包。
                  -->
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.cognitanexus.core.governance*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <!--
            三个核心模块之二：catalog.domain（成果规范实体与值对象）。
            选这个包而不是某个 API 包：这里放的是「谁能公开、什么值可被覆盖、哪种关系可建边」
            这类判断，红线写反了不会编译报错，只会静默放宽约束，最需要被用例钉住。
            同样必须挂 PACKAGE —— 理由见上面 governance 那条。
          -->
          <execution>
            <id>jacoco-check-catalog-domain</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <skip>${jacoco.check.skip}</skip>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
              <rules>
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.cognitanexus.core.catalog.domain*</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
