# CognitaNexus 配置样例。
#
# 复制为 .env 后填写。**本文件只放变量名与开发默认值，不放任何真实口令。**
# compose.yaml 里每个变量都带一个开发默认值，因此即使不建 .env 也能在开发机上起来；
# 但只要不是本机单机开发，下面每一项都必须显式覆盖。
#
# 唯一**没有默认值**的是 CN_BOOTSTRAP_ADMIN_PASSWORD：compose 会对它直接报错退出。
# 那是唯一一个「留空就等于把一个可写平台开放给所有人」的变量。

# ------------------------------ 数据库 ------------------------------

# PostgreSQL 超级用户，仅用于容器初始化；应用不使用它。
CN_PG_SUPERUSER=postgres
CN_PG_SUPERUSER_PASSWORD=change-me-superuser
CN_PG_PORT=5432

# 三个库各自两个账号：owner 有 DDL（Flyway 迁移用），app 只有 DML（服务运行用）。
# 这两组口令不能复用同一个值，否则「运行账号无 DDL 权限」这条约束就名存实亡。
CN_CORE_DB_OWNER_PASSWORD=change-me-core-owner
CN_CORE_DB_PASSWORD=change-me-core-app

CN_INGESTION_DB_OWNER_PASSWORD=change-me-ingestion-owner
CN_INGESTION_DB_PASSWORD=change-me-ingestion-app

CN_QUERY_DB_OWNER_PASSWORD=change-me-query-owner
CN_QUERY_DB_PASSWORD=change-me-query-app

# ------------------------------ Redis ------------------------------

# 会话实例：丢了就要重新登录，必须持久化。
CN_SESSION_REDIS_PASSWORD=change-me-session-redis
CN_SESSION_REDIS_PORT=6379

# 缓存实例：只放可丢弃派生数据，按 LRU 淘汰，不落盘。
CN_CACHE_REDIS_PASSWORD=change-me-cache-redis
CN_CACHE_REDIS_PORT=6380
CN_CACHE_MAXMEMORY=256mb

# ------------------------------ 服务间令牌 ------------------------------

# 内部端点鉴权。core 用 query 的令牌投递事件，因此 CN_QUERY_SERVICE_TOKEN 在 core 与
# query 两侧必须是同一个值；配错的现象是事件被 403 拒收、水位不动，而不是报错。
CN_QUERY_SERVICE_TOKEN=change-me-query-token
CN_INGESTION_SERVICE_TOKEN=change-me-ingestion-token
CN_CORE_SERVICE_TOKEN=change-me-core-token

# ------------------------------ 引导管理员 ------------------------------

# 首次启动时创建的平台管理员。仅在库中不存在活跃平台管理员时生效一次。
# 没有默认值：留空则 compose 拒绝启动。
CN_BOOTSTRAP_ADMIN_USERNAME=cnadmin
CN_BOOTSTRAP_ADMIN_PASSWORD=
CN_BOOTSTRAP_ADMIN_DISPLAY_NAME=平台管理员

# ------------------------------ 采集 ------------------------------

# 采集器对上游的自我标识。Crossref 与 OpenAlex 都要求可联系的 UA，
# 建议填真实联系邮箱，否则可能被限流或屏蔽。
CN_COLLECT_USER_AGENT=CognitaNexus/0.2 (mailto:your-email@example.edu.cn)

# ------------------------------ 端口 ------------------------------

CN_CORE_PORT=8081
CN_INGESTION_PORT=8082
CN_QUERY_PORT=8083
# 前端对外端口。这个端口是唯一需要暴露给用户的入口。
CN_WEB_PORT=8080
