<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.cognitanexus</groupId>
  <artifactId>cognitanexus-parent</artifactId>
  <version>0.2.0</version>
  <packaging>pom</packaging>
  <name>CognitaNexus Parent</name>
  <description>学术成果分享平台：三服务实现（core / ingestion / query）</description>

  <modules>
    <module>libraries/shared-kernel</module>
    <module>services/core-service</module>
    <module>services/ingestion-service</module>
    <module>services/query-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <mybatis-starter.version>3.0.5</mybatis-starter.version>
    <archunit.version>1.4.1</archunit.version>
    <testcontainers.version>1.21.3</testcontainers.version>
    <!--
      OpenAPI 文档（部署前功能项）。2.3.0 对应 Spring Boot 3.2；升级 Boot 时必须同步核对。
      本地 ~/.m2 起初没有这个依赖，构建机可访问 Maven 中央仓库，因此是「构建期在线、运行期离线」：
      打好的 jar 里已含 swagger-ui 静态资源，部署环境不需要外网。
    -->
    <springdoc.version>2.3.0</springdoc.version>
    <!--
      集成测试（*IT，由 failsafe 执行）需要真实 PostgreSQL 实例，默认不随 mvn verify 跑：
      常规构建不应被「本机有没有起测试库」绑死。要跑：
        bash ops/local/test-db.sh start
        ./mvnw -B -ntp verify -Dcn.it.skip=false -Dspotless.check.skip=true
      默认 skip 是显式记录的状态，不是「跑过并通过」；测试报告里按两次不同命令分别记。
    -->
    <cn.it.skip>true</cn.it.skip>
    <!-- 覆盖率门禁：三个核心模块各自的包前缀，见编码规范 8.3 -->
    <jacoco.line.coverage.minimum>0.80</jacoco.line.coverage.minimum>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.cognitanexus</groupId>
        <artifactId>shared-kernel</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mybatis.spring.boot</groupId>
        <artifactId>mybatis-spring-boot-starter</artifactId>
        <version>${mybatis-starter.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!--
      公共测试依赖不在此声明：shared-kernel 必须保持零框架依赖，
      由 enforcer 强制校验。各服务在自己的 pom 中声明测试依赖。
    -->
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- 单元测试：*Test；集成测试 *IT 交给 failsafe -->
            <excludes>
              <exclude>**/*IT.java</exclude>
            </excludes>
            <systemPropertyVariables>
              <file.encoding>UTF-8</file.encoding>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*IT.java</include>
            </includes>
            <!-- 见 properties 里的 cn.it.skip 说明：默认跳过，跑集成测试要显式打开。 -->
            <skipITs>${cn.it.skip}</skipITs>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.13</version>
          <executions>
            <execution>
              <id>prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>prepare-agent-integration</id>
              <goals>
                <goal>prepare-agent-integration</goal>
              </goals>
            </execution>
            <execution>
              <id>report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
                <goal>report-integration</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>2.44.3</version>
          <configuration>
            <java>
              <googleJavaFormat>
                <version>1.28.0</version>
                <style>GOOGLE</style>
                <!--
                  关闭 Javadoc 重排：本项目注释为中文，google-java-format 按西文
                  行长规则合并中文行，会破坏原有的逐条编号换行（如「3.3.1」式条款），
                  使评审时难以与需求编号对照。代码本体仍由该格式化器统一。
                -->
                <formatJavadoc>false</formatJavadoc>
              </googleJavaFormat>
              <importOrder/>
              <removeUnusedImports/>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </java>
          </configuration>
          <executions>
            <execution>
              <id>spotless-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <compilerArgs>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
