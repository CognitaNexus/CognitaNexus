# ===== 构建产物 =====
target/
build/
dist/
out/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ===== 前端 =====
node_modules/
.vite/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== 环境与密钥（严禁入库）=====
.env
.env.local
.env.*.local
*.jks
*.p12
*.pem
*.key
secrets/

# ===== 数据库与运行时数据 =====
*.db
*.sqlite
*.sqlite3
*.mv.db
*.trace.db
data/
logs/
*.log
pgdata/
# 本地整栈的进程标记：内容是 PID，每台机器都不一样，提交后每个人的工作区都显示「已修改」
ops/local/run/*.pid

# ===== 本地原始材料与本地产物（不入库）=====
.local/
tmp/
temp/
*.tmp

# 压测的库导出（单个 38–91 MB，属可重建产物，只留计数与耗时证据）
reports/**/*.dump

# ===== IDE =====
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
*.swp
*.swo

# ===== 操作系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 测试与覆盖率产物 =====
coverage/
jacoco.exec
*.exec
test-output/
allure-results/
# 前端逐页断言的截图（可随时重建，只留脚本）
tests/ui/.shots/
# 全站审计的运行产物（报告 JSON 与 markdown，每次跑都会重写，不入库）
tests/ui/.audit/

# ===== 本地助手工作数据（不入库）=====
.workbuddy/

# 个人临时文档，不入库
待办.docx
