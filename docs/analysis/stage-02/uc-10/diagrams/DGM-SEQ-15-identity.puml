@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam sequenceMessageAlign left
title DGM-SEQ-15 UC-10 核验学者身份与归属（分析序列）
actor "治理管线\n（UC-09／18／19）" as Pipeline
actor "管理员" as Admin
actor "相关学者" as Owner
boundary "IdentityVerificationUI" as UI
control "IdentityVerificationCoordinator" as Ctl
entity "User" as User
entity "ScholarAuthorization" as Auth
entity "SourceRecord" as Source
entity "Scholar" as Scholar
entity "IdentityCandidate" as IdCand
entity "AttributionCandidate" as AttrCand
entity "Authorship" as Rel
entity "WorkEntity" as Work
entity "ReviewEvidence" as Material
entity "AuditEvidence" as Audit

group 署名归属与证据（E1–E10）
  Pipeline -> UI : M1 交付已去重成果与参与者署名事实（成果引用＋署名原值/顺序/角色＋机构/外部标识原值＋来源引用）（E1）
  UI -> Ctl : M2 请求学者身份与归属处理（成果引用＋来源记录引用＋署名事实＋已认证上下文）
  Ctl -> Source : M3 只读读取署名/机构/外部标识原值、许可与到达时间（E2）
  Ctl -> Ctl : M4 校验来源许可与公开范围：原值不得改写（E2）
  Ctl -> Scholar : M5 追加身份证据项（姓名表达/机构及任职期/外部标识[来源/命名空间/可信度]/合作者/领域），逐项记来源与到达时间（E3）
  Ctl -> Audit : M6 登记私人联系方式剔除：不采集为消歧证据（A15）
  Ctl -> Ctl : M7 姓名表达归一为比对用形式：对外展示姓名不变（E4）
  Ctl -> Scholar : M8 登记别名候选并保留原表达与来源；无法归一者标待核验（E4；A14）
  Ctl -> Rel : M9 查询该署名×成果的既有关系状态（含已排除/争议）（E5）
  Rel --> Ctl : M10 返回既有关系状态与既有证据引用
  alt 该署名与成果已有已排除关系（A7）
    Ctl -> Ctl : M11 已排除关系不自动恢复：保持已排除（A7）
    Ctl -> Audit : M12 记录被拒绝的状态变更尝试（来源/时间/原状态）（A7）
    Ctl --> UI : M13 返回“保持已排除，未恢复为自动关联”（A7）
  else 无已排除关系
    Ctl -> Scholar : M14 按外部标识→姓名比对用形式→机构/合作者召回候选档案（E6）
    Scholar --> Ctl : M15 返回候选档案集合（零/唯一/多个）与各档案证据项
    Ctl -> Ctl : M16 同名资格守卫：姓名相同或相似本身不构成同人证据（A3）
    alt 候选档案为零
      Ctl -> Scholar : M17 建立新学者档案并保留原署名（E9）
      Ctl -> Rel : M18 建立一条关系（角色/顺序/来源证据），状态=待核验（E9）
      Ctl -> Audit : M19 记录“无档案新建＋待核验”依据（E9）
      Ctl --> UI : M20 返回“该署名待核验：已建立关系，未定位既有档案”
    else 候选档案唯一且满足已批准判定规则
      Ctl -> Ctl : M21 保守判定守卫：条件（a）同类型外部标识完全一致，或（b）机构一致∧合作者∧领域支持；规则未批准不得执行（E7）
      Ctl -> Rel : M22 建立/更新一条关系：状态=自动关联，附证据引用（E8）
      Ctl -> Ctl : M23 幂等归并：同一学者×成果的重复证据归入同一逻辑关系（ID-11）
      Ctl -> Audit : M24 记录自动关联依据（标识类型/规范值/证据清单/执行者类型=系统）（E8）
      Ctl --> UI : M25 返回“已建立自动关联关系”及依据
    else 候选档案多个或证据冲突（A4/A5）
      Ctl -> IdCand : M26 生成身份候选（成员档案≥2＋逐项命中与冲突＋排序依据仅供查看＋候选规模）（E10）
      Ctl -> AttrCand : M27 生成归属候选（署名原值/顺序/角色＋候选学者集合＋逐项证据）（E10）
      Ctl -> IdCand : M28 候选过多时限制规模并标注“候选过多，需人工筛查”（A12）
      Ctl -> Ctl : M29 不建立确定关系、不静默分配：原署名保留（A3/A4/A5）
      Ctl -> Audit : M30 记录候选生成（原因/候选数量/证据清单）（E10）
      Ctl --> UI : M31 返回“该署名待人工核验：公开归属结论不变”
    end
  end
end

group 管理员核验身份候选（E11–E15）
  Admin -> UI : M32 打开身份候选/归属争议处理项，查看成员与逐项证据（E11）
  UI -> Ctl : M33 请求候选详情与影响范围（候选引用＋已认证请求上下文）
  Ctl -> User : M34 校验账号状态与治理处置权限（E11）
  alt 未认证或账号已停用（A1）
    Ctl --> UI : M35 拒绝：无任何业务写入（A1）
    UI --> Admin : M36 显示拒绝，与越权/失败可区分（A1）
    Ctl -> Audit : M37 记录受控拒绝审计，不含凭据（A1）
  else 无治理处置权限（A2）
    Ctl --> UI : M38 拒绝越权：候选与关系状态不变（A2）
    UI --> Admin : M39 显示越权结果（A2）
    Ctl -> Audit : M40 记录受控越权尝试（A2）
  else 账号可用且具备治理处置权限
    Ctl -> IdCand : M41 读取候选成员/逐项命中与冲突/排序依据/状态版本（E11）
    Ctl -> Scholar : M42 读取候选档案的姓名表达/机构任职期/外部标识/合作者/领域证据与合并链（E11）
    Ctl -> Rel : M43 读取受影响关系集合（归属/角色/顺序/状态）（E11）
    Ctl -> Work : M44 只读读取受影响成果（类型/公开状态）以计算影响范围（E11）
    Ctl --> UI : M45 返回候选证据、影响范围（门户/成果/统计/网络）与可判定动作
    opt 相关学者提交本人相关说明或佐证材料（E12）
      Owner -> UI : M46 提交本人相关说明与佐证材料（提交者＋候选引用）（E12）
      UI -> Ctl : M47 登记说明与材料（提交者＋候选引用）（E12）
      Ctl -> Material : M48 登记材料与可见范围：提交者＋有权审核者（E12）
      Ctl -> Audit : M49 记录材料登记：不改关系状态、不构成本人确认（A18）
      Ctl --> UI : M50 返回“材料已登记，等待有权审核者判定”（E12）
    end
    Admin -> UI : M51 提交判定（确认同一人/确认非同一人/标记争议/请求补充证据）与理由（E13）
    UI -> Ctl : M52 提交判定（候选引用＋判定类型＋理由＋已认证上下文）（E13）
    Ctl -> IdCand : M53 读取状态版本与既有判定（A10）
    Ctl -> Ctl : M54 复核守卫：权限有效∧理由完整∧仍待核验∧版本未变（A10）
    alt 候选已被判定或状态版本已变化（A10）
      Ctl --> UI : M55 拒绝并返回当前状态与既有判定（A10）
      UI --> Admin : M56 显示“状态已变化”与当前状态（A10）
      Ctl -> Audit : M57 记录被拒绝的重复判定
    else 请求补充证据（A8）
      Ctl -> IdCand : M58 保持待核验并记录补充说明与请求（A8）
      Ctl -> Audit : M59 记录补充证据请求（A8）
      Ctl --> UI : M60 返回“候选仍待核验：新证据到达时更新”（A8）
    else 标记争议（A9）
      Ctl -> IdCand : M61 候选状态=争议中（A9）
      Ctl -> Rel : M62 相关关系状态=争议：保留双方证据（A9）
      Ctl -> Audit : M63 记录争议登记：提出方/证据/时间；争议期间禁止自动合并与自动关联（A9）
      Ctl --> UI : M64 返回“已标记争议：公开显示争议提示，不进入统计与合作边”（A9）
    else 确认非同一人（保持独立）
      Ctl -> IdCand : M65 候选状态=已排除（保持独立）并记录排除依据（E15）
      Ctl -> Ctl : M66 关闭该档案组合：后续不再自动生成同一组合（除出现新证据）（E15）
      Ctl -> Audit : M67 记录排除判定（依据/操作者/时间）（E15）
      Ctl --> UI : M68 返回“两档案保持独立，候选已关闭”（E15）
    else 确认同一人（合并）（E15）
      Ctl -> Ctl : M69 合并守卫：证据相容∧无部分合并∧写入完整，失败整体回滚（A11）
      Ctl -> Scholar : M70 合并档案：姓名表达/机构证据/外部标识/合作者证据取并集，被合并档案保留合并链（E15）
      Ctl -> Rel : M71 迁移关系并消除同一成果同一角色的重复条目，保留双方证据（A6）
      Ctl -> IdCand : M72 候选状态=已确认（合并）（E15）
      Ctl -> Audit : M73 记录合并判定（依据/操作者/时间/关键变化）（E15）
      Ctl --> UI : M74 返回“已合并为一个档案：别名与关系数量符合预期”（E15）
    end
  end
end

group 归属候选判定与纠正（E13–E16）
  Admin -> UI : M75 打开归属候选并提交处置（确认归属/改派/排除关系/拆分档案）与理由（E13）
  UI -> Ctl : M76 提交归属处置（归属候选引用＋关系引用＋处置类型＋理由＋已认证上下文）（E13）
  Ctl -> AttrCand : M77 读取署名原值/顺序/角色/候选学者/逐项证据/状态版本（E13）
  Ctl -> Auth : M78 只读确认既有授权与被授权主体：不转移、不撤销（A13）
  Ctl -> Ctl : M79 处置守卫：权限∧理由∧版本未变∧依据齐备∧不写本人确认；失败整体回滚（E14；A11）
  alt 与另一位管理员的判定冲突（A17）
    Ctl -> Audit : M80 记录冲突与双方依据，转更高权限确认（A17）
    Ctl --> UI : M81 返回“不覆盖既有判定：待更高权限确认”（A17）
  else 处置涉及已认领门户（A13）
    Ctl -> Audit : M82 记录“管理权不变、需生成认领冲突处理项”，队列属 FR14/UC-17（A13）
    Ctl --> UI : M83 返回“管理权不转移/不撤销，冲突处理项转后台待办”（A13）
  else 无冲突
    alt 确认归属（建立或改派关系）（E16）
      Ctl -> Rel : M84 建立/更新关系：归属=确认学者，状态=自动关联，附独立管理员审核证据（E16）
      Ctl -> AttrCand : M85 候选状态=已确认归属并记录依据（E15）
      Ctl -> Audit : M86 记录归属确认（前后归属/依据/操作者/时间）（E18）
      Ctl --> UI : M87 返回“归属已确认：门户与统计采用生效关系”（E15）
    else 排除错误关系（E16）
      Ctl -> Rel : M88 仅本关系状态=已排除（E16）
      Ctl -> Ctl : M89 核对：成果实体/全部来源/其他合法关系保留；已排除不得被自动恢复（BR-UC10-11）
      Ctl -> AttrCand : M90 候选状态=已排除并记录依据（E15）
      Ctl -> Audit : M91 记录排除（前后状态/依据/操作者/时间）（E18）
      Ctl --> UI : M92 返回“仅本关系排除：成果与其他合法关系保留”（E15）
    else 拆分错误合并的档案（E15）
      Ctl -> Scholar : M93 拆分为两个档案：别名与证据按来源分别归属，保留合并链（E15）
      Ctl -> Rel : M94 按证据恢复各自关系；无法确定的关系置待核验，不擅自分配（A16）
      Ctl -> Audit : M95 记录拆分（依据/操作者/时间/无法确定项）（E18）
      Ctl --> UI : M96 返回“拆分完成：无法确定归属的关系为待核验”（E15）
    end
  end
end

group 生效传播与结果（E17–E18）
  Ctl -> Work : M97 请求按生效关系更新参与展示：不改共享字段、不删除来源（E17）
  Ctl -> Scholar : M98 请求更新相关学者门户的归属状态与公开投影（E17）
  Ctl -> Ctl : M99 声明统计/FR12 基础网络/IN01 论文路径按同一生效关系重算，并逐视图记录传播时间（E17）
  Ctl -> Audit : M100 记录生效时刻、影响范围与传播结果；未生效时提示管理员（E18）
  Ctl --> UI : M101 返回判定结论、影响范围与“是否已生效”（E18）
  UI --> Admin : M102 显示结论、影响范围与未生效提示（如有）（E18）
  UI --> Owner : M103 显示本人门户状态说明：不暴露他人私人信息与材料原件（E18）
end
legend right
  生效传播与结果仅在判定成功写入并生效后执行；拒绝/冲突/仍待核验分支不进入该组。
  只分析 UC-10 学者身份与归属核验；认领审核、Scholar 档案字段维护、普通主页编辑、成果去重、本人确认/补录/纠错、公开浏览与审计查询不在本图。
  M16/M21/M29 是核心守卫：同名或相似不构成证据（BR-342）；条件（a)/(b) 只在已批准规则成立时可用（SPEC ID-02、§6.5；阈值待确认 B-03）；否则只生成候选。
  M26/M27 只生成 IdentityCandidate（档案组合）与 AttributionCandidate（署名归属），M29 明确不建立确定关系；候选不等于合并（AC-IMPL-FR15-01/03）。
  M62/M84 写入的关系状态为“争议”与“自动关联”；本图没有写“本人确认”的消息：管理员审核只形成独立审核证据（SPEC ID-06/ID-10；AC-IMPL-FR15-03/06）。
  M11–M13 与 M89 保证已排除关系不被再次采集自动恢复（AC-IMPL-FR15-04；§6.4 KeepExclusionWithNewEvidence）。
  M97–M100 只声明生效范围与传播记录，不改成果共享字段、不删来源、不合并成果实体（BR-341；FR15-S11）。
  A20（留痕失败不得报成功）与 A19（认领/档案维护/主页编辑/去重/本人确认不在本 UC）是顺序约束与范围边界，无独立消息。
  阈值、候选规模、时限、候选状态集合与授权转移条件均未冻结：标待确认（B-01～B-08），本图不写具体数值。
endlegend
@enduml
