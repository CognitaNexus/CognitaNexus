@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultFontSize 14
skinparam dpi 150
left to right direction
skinparam nodesep 18
skinparam ranksep 30
skinparam padding 8
title DGM-USECASE-01 CognitaNexus 总体用例\nV2.2 / 69 AC Baseline / 2026-10-20
actor "访客" as Public
actor "注册用户" as Applicant
actor "门户管理者" as Manager
actor "有权管理员" as Admin
actor "获准数据来源" as Source
rectangle "CognitaNexus" {
 rectangle "公开发现" as Discovery {
  usecase "UC-01 检索成果与学者" as Search
  usecase "UC-02 查看详情与来源" as Detail
  usecase "UC-03 查看公开个人主页/学者档案" as Portal
  usecase "UC-16 核对四类覆盖与来源" as Coverage
 }
 rectangle "门户与审核" as Portals {
  usecase "UC-04 注册账号并生成主页" as Account
  usecase "UC-05 提交和查询认领" as Claim
  usecase "UC-06 审核认领" as Review
  usecase "UC-07 维护已授权Scholar档案" as Maintain
  usecase "UC-08 确认补录和纠错成果" as Correct
  usecase "UC-22 编辑本人普通个人主页" as EditProfile
 }
 rectangle "采集与治理" as Governance {
  usecase "UC-18 管理来源及采集任务" as Collect
  usecase "UC-09 核验和纠正成果数据" as Govern
  usecase "UC-10 核验学者身份与归属" as Identity
  usecase "UC-19 管理来源更新" as Update
  usecase "UC-17 后台待办与审计" as Audit
 }
 rectangle "统计与网络" as Analytics {
  usecase "UC-11 查看成果统计" as Stats
  usecase "UC-12 查看机构排名" as Rank
  usecase "UC-13 查看领域热点" as Hot
  usecase "UC-14 查看四类共同成果合作网络" as Graph
  usecase "UC-15 筛选网络及最短路径" as Path <<Innovation>>
 }
 rectangle "延期 Optional" as Optional {
  usecase "UC-20 相似论文推荐" as Similar <<Optional>>
  usecase "UC-21 个性化推荐" as Personal <<Optional>>
 }
}
Public -- Search
Public -- Detail
Public -- Portal
Public -- Coverage
Public -- Stats
Public -- Rank
Public -- Hot
Public -- Graph
Public -- Path
Applicant -- Account
Applicant -- EditProfile
Applicant -- Claim
Manager -- Maintain
Manager -- Correct
Admin -- Review
Admin -- Maintain
Admin -- Correct
Admin -- Collect
Admin -- Govern
Admin -- Identity
Admin -- Update
Admin -- Audit
Source -- Collect
Source -- Update
note bottom of Govern
 清洗、去重是内部处理步骤，不另画外部业务用例。
 UC-09/10仅表示管理员可观察的核验/纠错目标。
end note
note bottom of EditProfile
 UC-22仅编辑本人普通UserProfile；
 学术身份、机构与归属按UC-07/UC-08审核。
 AC-IMPL-FR06-03/04/05。
end note
note bottom of Graph
 FR12基础网络使用论文/专利/项目/获奖四类合格共同成果；
 IN01路径只取共同论文子图。
end note
note bottom of Similar
 O01/O02延期，无Must依赖，不画无依据extend。
 角色关联表示职责，无账号状态之间的继承。
end note
@enduml