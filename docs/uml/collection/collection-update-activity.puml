@startdot
digraph G {
graph [fontname="Noto Sans CJK SC", bgcolor="white", pad="0.28", nodesep="0.42", ranksep="0.58", splines=polyline, outputorder=edgesfirst];
node [fontname="Noto Sans CJK SC", fontsize=11, color="#15324A", penwidth=1.3];
edge [fontname="Noto Sans CJK SC", fontsize=9, color="#087F8C", fontcolor="#15324A", arrowsize=0.68];
rankdir=TB; graph [ranksep="0.38",nodesep="0.38",splines=ortho];
node [shape=box,style="rounded,filled",fillcolor="#F4F9FC",margin="0.15,0.09"];
start [label="开始",shape=circle,style=filled,fillcolor="#15324A",fontcolor=white,width=.3,fixedsize=true];
admin1 [label="管理员：核验来源许可并配置范围",fillcolor="#E7F7F2"];
validate [label="系统：校验来源、权限与使用范围"];
valid [label="条件有效？",shape=diamond,fillcolor="#FFF3E2"];
error0 [label="系统：拒绝执行并显示原因",fillcolor="#FEEDEA"];
admin2 [label="管理员：创建待执行任务并启动",fillcolor="#E7F7F2"];
source1 [label="外部来源：返回授权范围内记录",fillcolor="#FFF6E8"];
check [label="读取或处理是否失败？",shape=diamond,fillcolor="#FFF3E2"];
fail [label="系统：失败；保留已完成数据\n记录错误与可恢复范围",fillcolor="#FEEDEA"];
classify [label="系统：按来源身份识别记录\n区分新增／未变／变更／异常"];
branch [label="识别结果",shape=diamond,fillcolor="#FFF3E2"];
unchanged [label="未变化：更新检查时间"];
unknown [label="身份不明：交异常或候选队列\n不强行合并"];
new [label="新增：交 FR09／FR15 治理\n去重与归属待核验不自动公开"];
changed [label="变更：保存前后值、来源版本\n校验人工审核／确认结果"];
protected [label="与人工结果冲突？",shape=diamond,fillcolor="#FFF3E2"];
queue [label="保留已生效值；新源值待核验\n交 FR07／FR14／FR15 处理"];
apply [label="按已确认规则生效更新\n保留来源和时间证据"];
complete [label="系统：本次读取范围是否完毕？",shape=diamond,fillcolor="#FFF3E2"];
success [label="任务成功：全范围读取结束且完成处置\n异常数量和待核验项单独显示",fillcolor="#E7F7F2"];
end0 [label="结束",shape=doublecircle,style=filled,fillcolor="#15324A",fontcolor=white,width=.35,fixedsize=true];
legend [shape=note,fontsize=9,fillcolor=white,label="绿色：管理员或成功结果；米色：来源／条件判断\n蓝白：系统处理；红色：失败或拒绝\n停止任务按 §6.2 状态图处理；Q-202 未冻结"];
start -> admin1 -> validate -> valid;
valid -> error0 [xlabel="否"];
valid -> admin2 [xlabel="是"];
admin2 -> source1 -> check;
check -> fail [xlabel="是"];
check -> classify [xlabel="否"];
classify -> branch;
branch -> unchanged [xlabel="未变"];
branch -> unknown [xlabel="异常"];
branch -> new [xlabel="新增"];
branch -> changed [xlabel="变更"];
changed -> protected;
protected -> queue [xlabel="是"];
protected -> apply [xlabel="否"];
{unchanged unknown new queue apply} -> complete;
complete -> success [xlabel="是"];
complete -> source1 [xlabel="否／继续",constraint=false];
{error0 fail success} -> end0;
legend -> end0 [style=invis];
}

@enddot