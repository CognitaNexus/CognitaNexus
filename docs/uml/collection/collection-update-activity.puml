@startuml
skinparam monochrome true
skinparam shadowing false
skinparam dpi 150
' Noto Sans CJK SC unavailable locally; use installed system default font.
title DGM-ACTIVITY-05 采集与增量更新业务活动图

start
partition "管理员" {
  :登记获准来源，声明类型、范围和性质;
  :创建任务并请求启动;
}
partition "系统" {
  if (权限、来源、范围及参数有效?) then (是)
    :保存快照，待执行→运行中;
  else (否)
    :拒绝并显示原因，保持原状态;
    stop
  endif
}

repeat
  partition "系统" {
    if (停止已先于完成生效?) then (是)
      :运行中→已停止;\n保留完成项与未完成范围;
      stop
    else (否)
      :按快照获取本轮范围的下一批;
    endif
  }
  partition "外部数据来源" {
    :提供获准记录或失败反馈;
  }
  partition "系统" {
    if (取得失败?) then (是)
      :运行中→失败;\n保存错误与恢复范围;
      note right
      管理员可按 FR08-S04 / FR10-S05 重试。
      重试→运行中／失败／已停止
      的合法转移见 DGM-STATE-01。
      历史成果仍可浏览。
      end note
      stop
    else (否)
      :逐条记录来源身份、性质及时间;
    endif
    if (身份和公共必要信息足够?) then (是)
      :按同源身份和规范化内容判定;
      if (新增来源记录?) then (是)
        :交 FR09/FR15 治理;\n保留全部出处;
      else (否)
        if (内容未变化?) then (是)
          :只更新检查时间;\n不重复成果或业务变更;
        else (否，变更)
          :保存源版本及前后差异;\n删除、撤稿、访问失败分别记录;
          if (与当前人工结果冲突\n或无法核验?) then (是)
            :保留公开值及确认／排除结果;\n交 FR07/FR14/FR15 待核验;
            :重复同版本复用待办;
          else (否)
            :按治理和展示规则生效;\n记录生效时间;
            :按 NF05 在检索、门户、统计反映;
          endif
        endif
      endif
    else (否)
      :交异常／候选队列;\n不编造字段与身份;
    endif
    if (处理或队列交接失败?) then (是)
      :运行中→失败;\n保存证据及恢复范围;
      stop
    else (否)
      :保存本批互斥处置计数;\n异常／冲突另显;
    endif
  }
repeat while (本轮范围仍未读完\n或仍有未完成项?) is (是) not (否)

partition "系统" {
  if (停止已先于完成生效?) then (是)
    :运行中→已停止，保留完成结果;
  else (否)
    :运行中→成功，保存汇总;
    :成功不表示全部公开或已核验归属;
  endif
}
partition "管理员" {
  :核对四类覆盖、来源证据和性质计数;
}
stop
@enduml