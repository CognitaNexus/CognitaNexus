@startdot
digraph G {
graph [fontname="Noto Sans CJK SC", bgcolor="white", pad="0.28", nodesep="0.42", ranksep="0.58", splines=polyline, outputorder=edgesfirst];
node [fontname="Noto Sans CJK SC", fontsize=11, color="#15324A", penwidth=1.3];
edge [fontname="Noto Sans CJK SC", fontsize=9, color="#087F8C", fontcolor="#15324A", arrowsize=0.68];
rankdir=LR; graph [ranksep="0.72", nodesep="0.5",splines=true];
node [shape=box,style="rounded,filled",margin="0.18,0.12",fillcolor="#F4F9FC",fontsize=12];
start [shape=circle,width=.20,label="",fillcolor="#15324A",style=filled];
ready [label="待执行",fillcolor="#E7F7F2"];
running [label="运行中",fillcolor="#DFF1FA"];
failed [label="失败",fillcolor="#FEEDEA"];
retry [label="重试",fillcolor="#FFF3E2"];
success [label="成功",fillcolor="#E7F7F2"];
stopped [label="已停止",fillcolor="#ECEEF1"];
end [shape=doublecircle,width=.20,label="",fillcolor="#15324A",style=filled];
start -> ready [label="创建有效任务"];
ready -> running [label="启动且校验通过"];
ready -> stopped [label="停止生效"];
running -> success [label="全范围完成处置\n(Q-202 待冻结)"];
running -> failed [label="取得或处理失败"];
running -> stopped [label="停止先生效"];
failed -> retry [label="管理员重试、条件有效"];
retry -> running [label="准备成功／新轮次"];
retry -> failed [label="准备失败"];
retry -> stopped [label="停止生效"];
success -> end [label="终态"];
stopped -> end [label="终态"];
}

@enddot